# Copy to server/wrangler.toml, fill in the values, then from the server/ folder run:
#   npx wrangler deploy
# Secrets are never written in this file. Add them once with:
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put TURNSTILE_SECRET      # only if you use Turnstile

name = "invite-contact"
main = "contact-worker.js"
compatibility_date = "2024-09-23"

[vars]
ALLOWED_ORIGIN = "https://invitee.ge"
TO_EMAIL = "replace-with-the-studio-inbox@example.com"
FROM_EMAIL = "INVITÉ website <replace-with-sender@your-verified-domain.example>"

# Optional soft rate limit (5 enquiries per IP per 10 minutes).
# Create a namespace with:  npx wrangler kv namespace create RATE_LIMIT
# [[kv_namespaces]]
# binding = "RATE_LIMIT"
# id = "paste-the-namespace-id-here"
